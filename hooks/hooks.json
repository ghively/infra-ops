{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/infra-session-bootstrap.js\""
          }
        ],
        "description": "Prime the session with SPEC/TODO/knowledge pointers and the hard trust-boundary rules",
        "id": "infra:session:bootstrap"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/chd-ingress-classifier.js\"",
            "timeout": 3
          }
        ],
        "description": "CHD ingress boundary: classify the submitted prompt and block CHD-adjacent content before it reaches the cloud model (fail-closed)",
        "id": "infra:intake:chd-ingress-classifier"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/sensitivity-router.js\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pan-egress-filter.js\"",
            "timeout": 3
          }
        ],
        "description": "DLP PAN/secrets blocking and CHD routing on EVERY tool — incl. WebFetch, WebSearch, and MCP tools, the cloud-egress channels a Bash-only matcher missed",
        "id": "infra:pre:dlp-sensitivity-all-tools"
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gateguard-fact-force.js\"",
            "timeout": 5
          }
        ],
        "description": "GateGuard fact-forcing investigation gate before file modification / destructive Bash",
        "id": "infra:pre:gateguard"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/prod-execution-guard.js\"",
            "timeout": 3
          }
        ],
        "description": "Enforce propose-never-dispose: deny ansible-playbook against non-dev inventories and promotion commands (SPEC §2 rule #1)",
        "id": "infra:pre:prod-execution-guard"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/yamllint-hook.js\"",
            "timeout": 3,
            "environment": {
              "INFRAOPS_YAMLLINT": "1"
            }
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/ansible-syntax-hook.js\"",
            "timeout": 5,
            "environment": {
              "INFRAOPS_ANSIBLE_SYNTAX": "1"
            }
          }
        ],
        "description": "Quality gates: yamllint and ansible-syntax-check for YAML files",
        "id": "infra:post:yaml-quality"
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/governance-capture.js\"",
            "timeout": 5,
            "environment": {
              "INFRAOPS_GOVERNANCE_CAPTURE": "1"
            }
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/observe-runner.js\"",
            "async": true,
            "timeout": 3,
            "environment": {
              "INFRAOPS_OBSERVE": "1"
            }
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/governance-ledger.js\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Governance capture, observation, and audit ledger (PCI Req 10)",
        "id": "infra:post:governance-observe-ledger"
      }
    ]
  }
}
